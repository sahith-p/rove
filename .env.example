# Copy to .env at the repo root. Each app reads the vars it needs. Owner in brackets fills it in.

# --- shared ---
NEXT_PUBLIC_ROVE_NUMBER=                             # [Saran] the Photon line customers/merchants text (shown on landing + stickers)
PUBLIC_BASE_URL=https://rove-demo.vercel.app       # [Sahith] the web app's public URL (card links, QR links)
INTERNAL_SECRET=change-me                            # [Nithya] bearer token for /internal/* calls between services
TOKEN_SECRET=change-me                               # [Sahith] HMAC key for merchant page sessions + confirm buttons
WORKER_URL=http://localhost:4001                     # [Nithya]
AGENT_URL=http://localhost:4002                      # [Saran]

# --- mocks (1 = use mock implementation from packages/shared/src/mocks) ---
USE_MOCK_SETTLEMENT=1                                # flip to 0 after gate G1
USE_MOCK_PAYOUTS=1                                   # stays 1 for the demo (simulated StraitsX), labeled on screen
USE_MOCK_CARDS=1                                     # 1 = log cards to console instead of Photon; flip after gate G2
USE_TERMINAL_PROVIDER=1                              # 1 = agent also listens on the terminal provider (local dev)

# --- database (Supabase) [Nithya] ---
DATABASE_URL=                                        # Supabase → Connect → Transaction pooler (port 6543). Server-side only. @rove/db talks SQL directly (real transactions)

# --- Stripe (test mode) [Nithya] ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# --- XRPL testnet [Nithya] (pnpm seed writes these to .env.seed; copy them here) ---
XRPL_WSS=wss://s.altnet.rippletest.net:51233
XRPL_USD_ISSUER=                                     # issuer of the RLUSD stand-in
XRPL_SGD_ISSUER=                                     # issuer of the XSGD stand-in
XRPL_TREASURY_SEED=                                  # worker only (signs). Never on Vercel
XRPL_TREASURY_ADDRESS=                               # public; the web app quotes with this, no seed needed
XRPL_REDEMPTION_ADDRESS=                             # stands in for StraitsX's XSGD redemption deposit address
XRPL_REDEMPTION_SEED=                                # worker only (demo: lets the redemption account act like StraitsX)
XRPL_LP_SEED=                                        # seed script only (AMM liquidity provider)
XRPL_CREDENTIAL_ISSUER_SEED=                         # worker only
XRPL_CREDENTIAL_ISSUER_ADDRESS=                      # public; the web app checks the verified badge with this
DEMO_MERCHANT_XRPL_ADDRESS=                          # from pnpm seed; @rove/db seed:demo stores it on ahseng
DEMO_MERCHANT_SEED_ENC=                              # from pnpm seed (encrypted with WALLET_ENCRYPTION_KEY); worker/db seed only
DEMO_MERCHANT_CREDENTIAL_STATUS=                     # from pnpm seed (accepted | issued); @rove/db seed:demo
WALLET_ENCRYPTION_KEY=                               # 32-byte hex; encrypts merchant seeds at rest (demo custody). Worker only

# --- BNB Chain pay-in lane [Nithya backend, Sahith Privy UI] ---
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545   # BSC testnet (chainId 97); swap for any testnet RPC
BSC_TOKEN_ADDRESS=                                   # test USDT (faucet token or our 20-line ERC-20)
BSC_TOKEN_DECIMALS=18
BSC_DEPOSIT_MNEMONIC=                                # HD wallet for per-payment deposit addresses (testnet only). Worker only
BSC_DEPOSIT_XPUB=                                    # account xpub of that mnemonic (m/44'/60'/0'/0); the web app derives deposit addresses from it
NEXT_PUBLIC_PRIVY_APP_ID=                            # Privy embedded EVM wallet for customers

# --- Photon Spectrum [Saran] ---
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WHATSAPP_BUSINESS_ACCESS_TOKEN=             # Meta system-user token (or leave empty to use a Photon cloud WhatsApp line)
SPECTRUM_WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
SPECTRUM_WHATSAPP_BUSINESS_APP_SECRET=
WHATSAPP_INVOICE_TEMPLATE=rove_invoice
TERMINAL_AS=merchant                                 # local dev: who the terminal user is (merchant | customer)

# --- Claude [Saran] ---
ANTHROPIC_API_KEY=

# --- ElevenLabs [Saran] ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- BNB lane, NI-C6 additions [Nithya] (docs/specs/bnb-lane.md) ---
# BSC_RPC_URL: the bnbchain.org data-seed endpoints above refuse eth_getLogs ("limit exceeded"), which the watcher needs.
#   Use https://bsc-testnet-rpc.publicnode.com (the worker's default when BSC_RPC_URL is empty).
# BSC_TOKEN_ADDRESS: our tUSDT from `pnpm --filter worker exec tsx scripts/bsc-setup.ts deploy` (18 decimals), or the
#   faucet's USDT 0x337610d27c682E347C9cD60BD4b3b107C9d34dDd (also 18). Unset = watcher off, checkout bnb answers 503.
# The web needs only BSC_DEPOSIT_XPUB + BSC_TOKEN_ADDRESS + BSC_TOKEN_DECIMALS (no keys on Vercel).
# scripts/bsc-setup.ts writes all of these (and the keys) to a gitignored .env.bsc at the repo root, mode 600.
BSC_POLL_MS=3000                                     # worker: watcher poll period
BSC_RESCAN_BLOCKS=10000                              # worker: blocks rescanned on boot (~75 min at 0.45 s blocks; claim() dedupes)
BSC_LOG_RANGE=5000                                   # worker: max blocks per eth_getLogs call
BSC_DEPLOYER_KEY=                                    # scripts/bsc-setup.ts only (TESTNET key: deploys tUSDT, mints, sends test gas). Never on Vercel/Railway
